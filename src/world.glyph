    },
  },
  {
    id: "mire",
    title: "The Mire",
    kind: Wild,
    text: "Standing water, black to the knee, and stands of alder growing out of it at angles that suggest the ground is still deciding. Every step costs two. There is game here for anyone patient enough to be still, and being still here is expensive.",
    a: { label: "Wade for the far bank", goto: "far_bank", energy: 16, coin: 0, note: "" },
    b: {
      label: "Back to firm ground",
      goto: "ferry_landing",
      energy: 15,
      coin: 0,
      note: "Firm ground turns out to be a plank jetty. The ferryman nods, as at a returning customer.",
    },
  },
  {
    id: "far_bank",
    title: "The Far Bank",
    kind: Empty,
    text: "A chapel with no roof and a bell with no rope, and a step worn into a curve by people who evidently sat here often and for a long while. From the step you can see the road climbing east, and it looks, from here, entirely straightforward.",
    a: { label: "Climb east to the crossroads", goto: "crossroads", energy: 10, coin: 0, note: "" },
    b: { label: "Go back down to the water", goto: "ferry_landing", energy: 6, coin: 0, note: "" },
  },
  {
    id: "crossroads",
    title: "Ellum Cross",
    kind: Empty,
