module world

import std/array
import types { Place, Empty, Wild, Market, Waystop, Shrine, Gate, Ending }

// The road graph. Three of these places are cycle hubs -- the milestone,
// the ferry landing and the nine stones. Each can be arrived at from more
// than one direction, and each gives up a word on the third arrival.
pub const PLACES: Array<Place> = [
  {
    id: "vareska",
    title: "Vareska, the Last Market",
    kind: Market,
    text: "Vareska ends where the plain begins, and it knows it. The market is folding itself away for the evening: awnings down, crates stacked, a man selling boots that have plainly walked further than he has. Everyone you ask about the eastern road gives the same answer, which is that they have never been, and that their father never went either. A crow on the weighbridge watches you count your money.",
    a: {
      label: "Take the east gate, toward Ashford",
      goto: "ashford_gate",
      energy: 6,
      coin: 0,
      note: "",
    },
    b: {
      label: "Go down to the Blackwater stair",
      goto: "blackwater_stair",
      energy: 6,
      coin: 0,
      note: "",
    },
  },
  {
    id: "ashford_gate",
    title: "The Ashford Gate",
    kind: Empty,
    text: "The gate is a gate only by courtesy: two posts and a lintel, and no wall anywhere for it to interrupt. Someone has carved a tally into the left post, six strokes and a seventh half-finished. A crow sits on the lintel with the settled patience of a thing being paid by the hour.",
    a: {
      label: "Follow the road to the milestone",
      goto: "milestone",
      energy: 8,
      coin: 0,
      note: "",
    },
    b: { label: "Cut along the orchard edge", goto: "orchard_edge", energy: 12, coin: 0, note: "" },
  },
  {
    id: "milestone",
    title: "The Scorched Milestone",
    kind: Wild,
    text: "A milestone, scorched black down its western face, the distance on it burned away to a smooth nothing. The grass around it is beaten flat in a wide ring, as if a great many people had stood here a great many times, thinking.",
