  },
  {
    id: "reed_flats",
    title: "The Reed Flats",
    kind: Wild,
    text: "Reeds over your head for a mile in every direction, and a path through them that was made by something shorter than you. Birds go up ahead of you and come down behind you, and by that you can tell you are being followed by nothing but yourself.",
    a: { label: "Push on to the sunken road", goto: "sunken_road", energy: 11, coin: 0, note: "" },
    b: {
      label: "Bear left, back toward the water",
