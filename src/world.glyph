  {
    id: "charcoal_camp",
    title: "The Charcoal Burners' Camp",
    kind: Waystop,
    text: "Four turf kilns, smoking patiently, and a crew who sleep in shifts so that the fires are never once unwatched. They will trade a watch of hard labour for coin, and they will sell you bread at a price that says they know exactly how far the next bread is.",
    a: { label: "Take the drove road north", goto: "cart_ruts", energy: 11, coin: 0, note: "" },
    b: { label: "Go back down to the road", goto: "milestone", energy: 9, coin: 0, note: "" },
