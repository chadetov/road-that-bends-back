  {
    id: "nine_stones",
    title: "The Nine Stones",
    kind: Shrine,
    text: "Nine standing stones in a ring on the open heath. You count them and get nine. You count them again, from the other end, and get nine, and the certainty you had a moment ago is somehow not there any more.",
    a: { label: "Leave east across the heath", goto: "heath", energy: 12, coin: 0, note: "" },
    b: {
      label: "Walk the ring and count them once more",
