    b: {
      label: "Cut through the burnt orchard",
      goto: "burnt_orchard",
      energy: 16,
      coin: 0,
      note: "",
    },
  },
  {
    id: "burnt_orchard",
    title: "The Burnt Orchard",
    kind: Wild,
    text: "Trees in rows, every one of them dead and every one of them still standing, which is the part that troubles you. The rows run north. You are fairly sure the rows run north.",
    a: {
      label: "Press on down the rows",
      goto: "milestone",
      energy: 14,
      coin: 0,
      note: "You walk the rows until the rows end, and the road hands you back to the milestone.",
    },
    b: {
      label: "Break out sideways through the hedge",
      goto: "orchard_edge",
      energy: 9,
      coin: 0,
      note: "",
    },
  },
  {
    id: "orchard_edge",
    title: "The Orchard Edge",
    kind: Wild,
    text: "A ditch, a hedge, and a woman burning brush who will answer a question about the weather and no question at all about the road. The smoke goes up very straight. There is no wind to speak of, and there has not been for some days.",
    a: {
      label: "Rejoin the road at the milestone",
      goto: "milestone",
      energy: 10,
      coin: 0,
      note: "",
    },
    b: {
      label: "Follow the smoke to the burners' camp",
      goto: "charcoal_camp",
      energy: 12,
      coin: 0,
      note: "",
    },
